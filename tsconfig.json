{
	"compilerOptions": {
		"outDir": "./dist/",
		"rootDir": "./src",
		"sourceMap": true,
		"noImplicitAny": true,
		"module": "ESNext",
		"target": "ES2020",
		"allowJs": true,
		"resolveJsonModule": true,
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"strict": false,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*"],
	"exclude": ["src/assets/CustomTilesets", "node_modules", "dist"]
}