{
    "name": "evereign",
    "version": "0.7.15",
    "description": "A fantasy MMORPG built with Phaser and Electron.",
    "main": "main.js",
    "scripts": {
        "dev": "webpack --config webpack.config.js --mode=development --watch",
        "prod": "webpack --config webpack.config.js --mode=production",
        "build": "npm run prod",
        "build:web": "npm run prod"
    },
    "author": "Nathan Leadbitter <nathanl38@protonmail.com>",
    "license": "ISC",
    "devDependencies": {
        "@timohausmann/quadtree-ts": "^2.2.2",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^6.8.1",
        "electron": "^41.2.0",
        "electron-builder": "^26.0.12",
        "file-loader": "^6.2.0",
        "html-webpack-plugin": "^5.5.3",
        "js-base64": "^3.7.7",
        "mini-css-extract-plugin": "^2.7.6",
        "phaser": "4.2.0",
        "phaser4-rex-plugins": "^4.0.5",
        "sass": "^1.77.8",
        "sass-loader": "^16.0.1",
        "ts-loader": "^9.5.0",
        "typescript": "^5.2.2",
        "webpack": "^5.96.1",
        "webpack-cli": "^5.1.4"
    },
    "build": {
        "appId": "com.chungco.evereign",
        "productName": "Evereign",
        "icon": "./src/assets/images/icon.ico",
        "directories": {
            "output": "build",
            "buildResources": "dist"
        },
        "win": {
            "target": "zip"
        },
        "files": [
            "**/*",
            "dist/**/*",
            "!.github",
            "!.vs",
            "!node_modules/*"
        ]
    }
}
